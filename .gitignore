## Only the project scripts are tracked; data, inputs, cache, outputs, modules and logs are made by running them.
/*
!/.gitignore
!/README.md
!/global.R
!/experiment.R
!/dashboard.R
## modules are git submodules (setupProject useGit = "sub")
!/.gitmodules
!/modules/
.Rprofile
cache
inputs
outputs/ZONE/clearcut_R100
scratch/raster
scratch/terra
scratch
.Rproj.user
.Rhistory
.Rdata
.RData
.secret
.secrets
.Restart*
